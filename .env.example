# Flask Settings
SECRET_KEY=your-super-secret-key-change-this

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# JoshAtticus ID OAuth
JOSHATTICUS_CLIENT_ID=your-joshatticus-client-id
JOSHATTICUS_CLIENT_SECRET=your-joshatticus-client-secret

# IPHub Key
IPHUB_KEY=

# Admin bootstrap: OAuth id ('sub') that should be granted admin on first login.
# Find yours via the provider (Google 'sub' claim, GitHub numeric user id, or
# your JoshAtticusID 'sub'). Leave empty to grant admin to nobody automatically.
ADMIN_OAUTH_ID=